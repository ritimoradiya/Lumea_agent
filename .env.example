# ─────────────────────────────────────────────
#  Lumea Agent — environment template
#  Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────

# ─── Which brain to use: groq | ollama ───
BRAIN=groq

# Which company the agent represents — see config/companies/*.json
COMPANY_SLUG=lumea

# ─── Groq (cloud brain) ───────────────────────
# console.groq.com/keys  →  starts with gsk_
GROQ_API_KEY=
# Run `npm run models` to confirm what your account can actually use — model
# availability differs per account, and a name that works elsewhere may not
# work on yours.
GROQ_MODEL=openai/gpt-oss-120b

# Used automatically when the primary hits its per-day token cap. Groq counts
# tokens per day PER MODEL, so this roughly doubles the daily budget and is
# why replies keep working after the primary is exhausted.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ─── Ollama (local brain, optional — Phase 10) ─
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# ─── Supabase ─────────────────────────────────
# Project Settings → API  (or the "Connect" button)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Gmail (Lumea's inbox) — Phase 7 ──────────
# The throwaway account + its 16-character App Password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─── Telegram — Phase 6 ───────────────────────
# From @BotFather, looks like 8123456789:AAH...
TELEGRAM_BOT_TOKEN=

# ─── Local-only below this line ───────────────
# Nothing below is needed in a deployed environment.

# ─── ngrok (only needed for Ollama mode) ──────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ─── Where lead alerts are sent ───────────────
# YOUR real email — the one you actually read
OWNER_NOTIFY_EMAIL=

# ═══ ADMIN PANEL ═════════════════════════════
# Any password you like — gates /admin
ADMIN_PASSWORD=

# Any random string. Only needed once deployed and using a webhook
# instead of `npm run telegram`.
TELEGRAM_WEBHOOK_SECRET=

# ═══ RATE LIMITS ═════════════════════════════
# Agent replies allowed per hour. Protects the Groq daily budget once the
# site is public — ~170 turns a day is the ceiling across both models.
LIMIT_PER_THREAD=25
LIMIT_GLOBAL=120

